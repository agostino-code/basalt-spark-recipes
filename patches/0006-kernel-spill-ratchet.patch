diff --git a/CONTRIBUTING.md b/CONTRIBUTING.md
index d178cc03..e934d83b 100644
--- a/CONTRIBUTING.md
+++ b/CONTRIBUTING.md
@@ -22,6 +22,7 @@ Basalt is a local inference engine for NVIDIA Blackwell GPUs. Every rule below e
 - **One serving loop** runs every request of every model; a model plugs into it and never forks it. See [persistent serving](src/program/serve/README.md).
 - **The engine does the work, the server serves.** Tokenizing and per-request work run in C++. `serve/` parses, routes and streams, names no model, and never repairs model output; constrained decoding (grammar) handles structure.
 - **Build structure: no slow TU.** A clean Release build must finish in under 10 minutes on 32 threads, and nvcc compiles a translation unit on one core, so the build takes as long as its slowest `.cu`. Keep every `.cu` to about a minute or two alone: a kernel that is instantiated in several variants (like `dm_peer_kernel`) gets one `.cu` per variant, behind a getter that returns its address (no relocatable device code), and shared device code goes in a header with no kernel in it. A `.cu` does not include another `.cu` (`tools/check_cu_includes.sh` fails on a new one; `tools/cu_includes.allow` lists the few that must inline). Time a new or changed `.cu` alone (`nvcc --time`) and report it with the change.
+- **Kernel spill ratchet.** The build's Spark leg runs `tools/check_cuda_spill.sh` over `bin/basalt`: a kernel whose `STACK` or `LOCAL` in `cuobjdump -res-usage` is above zero must already have its line in `tools/spill.allow`, keyed by the fatbin arch, with the reason it must spill in the commit. A new spilling kernel without a line is a failing check; a line whose kernel no longer spilling is reported, not failed (the spilling set is per build and per arch).
 
 ## What every change must include
 
diff --git a/tools/check_cuda_spill.sh b/tools/check_cuda_spill.sh
new file mode 100755
index 00000000..3e29ec88
--- /dev/null
+++ b/tools/check_cuda_spill.sh
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+# A kernel that spills registers or its frame pays for the spill in the loop that runs it, and the
+# loop is the decode pass. This fails when the built engine shows STACK or LOCAL above zero for a
+# function that tools/spill.allow does not list under the fatbin's arch. A new kernel that must
+# spill (a deep reduction, a wide prologue) takes a line there with the reason in the commit.
+# An allow line whose function no longer spills only ages the list: the spilling set is per build
+# and per arch, so it is counted and reported, not failed.
+#
+#   tools/check_cuda_spill.sh [BINARY] [--list-aged]   bin/basalt by default; run after cmake --build
+set -euo pipefail
+cd "$(dirname "$0")/.."
+
+BIN=""
+LIST_AGED=0
+for a in "$@"; do
+  case "$a" in
+    --list-aged) LIST_AGED=1 ;;
+    *) BIN="$a" ;;
+  esac
+done
+BIN="${BIN:-bin/basalt}"
+ALLOW="${SPILL_ALLOW:-tools/spill.allow}"
+
+command -v cuobjdump >/dev/null 2>&1 || { echo "spill: cuobjdump is not on PATH (it comes with the CUDA toolkit)" >&2; exit 2; }
+[ -r "$BIN" ] || { echo "spill: no readable binary at $BIN (build it: cmake --build build)" >&2; exit 2; }
+[ -r "$ALLOW" ] || { echo "spill: no allow list at $ALLOW" >&2; exit 2; }
+
+status=0
+declare -A allowed seen
+while read -r arch sym _; do
+  case "$arch" in ''|'#'*) continue ;; esac
+  allowed["${arch} ${sym}"]=1
+done < "$ALLOW"
+
+arch=""
+pending=""
+while IFS= read -r line; do
+  case "$line" in
+    *'arch = '*)
+      arch="${line#*arch = }"; arch="${arch%%[[:space:]]*}"
+      pending=""
+      ;;
+    *'Function '*)
+      f="${line#*Function }"; f="${f%:}"; f="${f#: }"          # "Function <name>:" and "Function : <name>"
+      pending="${arch} ${f}"
+      ;;
+    *'STACK:'*|*'LOCAL:'*)
+      [[ -n "${pending:-}" ]] || continue
+      stack=0; localn=0
+      [[ "$line" =~ STACK:([0-9]+) ]] && stack="${BASH_REMATCH[1]}"
+      [[ "$line" =~ LOCAL:([0-9]+) ]] && localn="${BASH_REMATCH[1]}"
+      if (( stack > 0 || localn > 0 )); then
+        seen["$pending"]=1
+        if [[ -z "${allowed[$pending]:-}" ]]; then
+          echo "spill: ${pending} STACK:${stack} LOCAL:${localn}" >&2
+          echo "  give the kernel the headroom it needs, or add '${pending}' to ${ALLOW} with the reason in the commit" >&2
+          status=1
+        fi
+      fi
+      pending=""
+      ;;
+  esac
+done < <(cuobjdump -res-usage "$BIN" 2>/dev/null)
+
+aged=()
+for key in "${!allowed[@]}"; do
+  [[ -n "${seen[$key]:-}" ]] || aged+=("$key")
+done
+if (( ${#aged[@]} > 0 )); then
+  if (( LIST_AGED )); then
+    for key in "${aged[@]}"; do echo "spill: aged allow line (no longer spilling here): ${key}" >&2; done
+  fi
+  echo "spill: ${#aged[@]} allow line(s) no longer spilling under this build (the set is per build and per arch; prune the ones that are yours)" >&2
+fi
+exit "$status"
