+#!/usr/bin/env python3
+"""Long-context recall on the served API: needles planted in filler of a chosen depth, then found or not.
+
+    niah_gate.py BASE_URL [--model M] [--depths 8192,65536] [--needles 8] [--seed 1234]
+                         [--min-recall 1.0] [--request-timeout 900] [--out FILE.json]
+
+Each depth builds one conversation-length prompt from filler sentences with `needles` planted lines
+spaced evenly through it, then asks one question per needle. A needle reads like the sentence
+
+    the crimson fox carries a brass lantern number 731 near the pier
+
+and its question names the object, its color and its landmark but never its number; the answer is
+right when that number stands alone in the reply. Recall under --min-recall at any depth exits 1; a
+transport error exits 2; 0 prints the PASS line. `--out` keeps every row (depth, target and actual
+tokens, hits, seconds) for the record. The words-to-tokens rate comes from the server's own usage
+count of a calibration probe when it reports one, and from a constant estimate when it does not.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import random
+import re
+import sys
+import time
+import urllib.request
+
+ADJ = ["crimson", "cobalt", "amber", "jade", "violet", "silver", "ochre", "ivory", "scarlet", "indigo"]
+ANIMAL = ["fox", "heron", "badger", "otter", "falcon", "marten", "lynx", "crane", "shrew", "mole"]
+VERB = ["carries", "guards", "trades for", "borrows", "returns", "polishes", "hides", "counts"]
+ITEM = ["lantern", "compass", "ledger", "amphora", "spyglass", "crate", "medal", "ferry ticket"]
+PLACE = ["pier", "lighthouse", "orchard", "viaduct", "quarry", "depot", "millrace", "greenhouse"]
+FILLER = [
+    "The committee reviewed the quarterly figures and noted that the regional offices met their targets.",
+    "Rain arrived late that season and the harvest moved indoors under canvas and lamplight.",
+    "The ferry kept its timetable through the fog, and the deckhands said nothing about the delay.",
+    "She annotated the proof in the margin and left the corollary to the next reading.",
+    "The archive catalogued the shipment twice, once by weight and once by the crate's stamped seal.",
+    "Volumes three through seven arrived damaged and were rebound at the city press.",
+    "The surveyor walked the boundary again after the river moved its bed downstream.",
+    "He set the type by hand, line by line, and proofed the sheet before the first run.",
+]
+TPW = 1.35  # tokens per word for the estimate, the rate the English above measures near
+KEY_RE = r"(?<![\d.]){nn}(?![\d])"
+
+
+def plant(rng: random.Random, n: int) -> list[dict]:
+    """n needles with unique numbers and distinguishable (color, item, place) triples."""
+    used, out = set(), []
+    for _ in range(n):
+        while True:
+            row = dict(zip(("adj", "animal", "verb", "color", "item", "place"),
+                           (rng.choice(ADJ), rng.choice(ANIMAL), rng.choice(VERB),
+                            rng.choice(ADJ), rng.choice(ITEM), rng.choice(PLACE))))
+            nn = rng.randrange(100, 1000)
+            trip = (row["color"], row["item"], row["place"])
+            if trip not in used and all(nn != r["nn"] for r in out):
+                used.add(trip)
+                row["nn"] = nn
+                out.append(row)
+                break
+    return out
+
+
+def sentence(ndl: dict) -> str:
+    return f"The {ndl['adj']} {ndl['animal']} {ndl['verb']} the {ndl['color']} {ndl['item']} number {ndl['nn']} near the {ndl['place']}."
+
+
+def question(ndl: dict) -> str:
+    return (f"The text above mentioned the {ndl['color']} {ndl['item']} near the {ndl['place']}. "
+            f"What number was written on it? Answer with the number alone.")
+
+
+def prompt_words(target_tokens: int, tpw: float, needles: list[dict]) -> list[str]:
+    """The filler sentences around the needles, spaced evenly, sized to target_tokens."""
+    n = len(needles)
+    words = max(n, int(target_tokens / tpw))   # the text's words (the target is in tokens, tpw words -> tokens)
+    lines, have, i = [], 0, 0
+    while have < words:                        # FILLER entries are whole sentences: count the words they carry
+        f = FILLER[i % len(FILLER)]
+        lines.append(f)
+        have += f.count(" ") + 1
+        i += 1
+    slots = [int((k + 1) * len(lines) / (n + 1)) for k in range(n)]
+    for slot, ndl in zip(slots, needles):
+        lines.insert(slot, sentence(ndl))
+    return lines
+
+
+def ask(transport, model: str, text: str, max_tokens: int) -> tuple[str, int | None]:
+    payload = {"temperature": 0, "max_tokens": max_tokens}
+    if model:
+        payload["model"] = model
+    payload["messages"] = [{"role": "user", "content": text}]
+    reply, usage = transport(payload)
+    tokens = None
+    if isinstance(usage, dict):
+        pt = usage.get("prompt_tokens")
+        tokens = pt if isinstance(pt, int) else None
+    return reply, tokens
+
+
+def calibrate(transport, model: str) -> float:
+    """The words-to-tokens factor from one probe, or the constant estimate when usage is absent."""
+    probe = " ".join([FILLER[0]] * 8)
+    probe_words = probe.count(" ") + 1
+    _, tok = ask(transport, model, probe, 8)
+    if tok and tok > 0:
+        return tok / probe_words
+    print("niah: the server gave no usage; estimating tokens with 1.35 per word", file=sys.stderr)
+    return TPW
+
+
+def run_depth(transport, model: str, rng: random.Random, target: int, n: int, tpw: float,
+              needles: list[dict] | None = None) -> dict:
+    needles = needles if needles is not None else plant(rng, n)
+    lines = prompt_words(target, tpw, needles)
+    text = " ".join(lines)
+    hits, misses = 0, []
+    t0 = time.monotonic()
+    for ndl in needles:
+        reply, _ = ask(transport, model, text + "\n\n" + question(ndl), 256)
+        if re.search(KEY_RE.format(nn=ndl["nn"]), reply):
+            hits += 1
+        else:
+            misses.append({"nn": ndl["nn"], "reply": reply.strip()[:120]})
+    secs = time.monotonic() - t0
+    return {"depth": target, "needles": n, "hits": hits, "recall": hits / n if n else 1.0,
+            "seconds": round(secs, 1), "misses": misses}
+
+
+def post_factory(base: str, timeout: int):
+    url = base.rstrip("/") + "/v1/chat/completions"
+
+    def transport(payload: dict) -> tuple[str, dict | None]:
+        req = urllib.request.Request(url, data=json.dumps(payload).encode(),
+                                     headers={"Content-Type": "application/json"}, method="POST")
+        with urllib.request.urlopen(req, timeout=timeout) as r:
+            body = json.loads(r.read().decode())
+        try:
+            msg = body["choices"][0]["message"]
+            # a reasoning model puts the text in reasoning_content while thinking (content is null until it answers)
+            return (msg.get("content") or msg.get("reasoning_content") or ""), body.get("usage")
+        except (KeyError, IndexError, TypeError) as exc:
+            raise RuntimeError(f"unexpected reply shape: {exc}") from exc
+
+    return transport
+
+
+def main(argv: list[str] | None = None, transport=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("base", help="http://host:port of a running server")
+    ap.add_argument("--model", default="")
+    ap.add_argument("--depths", default="8192,65536", help="comma-separated token depths")
+    ap.add_argument("--needles", type=int, default=8)
+    ap.add_argument("--seed", type=int, default=1234)
+    ap.add_argument("--min-recall", type=float, default=1.0)
+    ap.add_argument("--request-timeout", type=int, default=900)
+    ap.add_argument("--out", default="", help="write the rows as JSON here")
+    args = ap.parse_args(argv)
+
+    tp = transport or post_factory(args.base, args.request_timeout)
+    try:
+        tpw = calibrate(tp, args.model)
+        rng = random.Random(args.seed)
+        rows = [run_depth(tp, args.model, rng, d, args.needles, tpw) for d in
+                (int(x) for x in args.depths.split(",") if x.strip())]
+    except RuntimeError as exc:
+        print(f"niah: transport error: {exc}", file=sys.stderr)
+        return 2
+
+    for row in rows:
+        flag = "ok " if row["recall"] >= args.min_recall else "LOW"
+        print(f"niah: [{flag}] depth {row['depth']:>7} needles {row['needles']:>2} "
+              f"hits {row['hits']:>2} recall {row['recall']:.3f} {row['seconds']:>6.1f}s")
+        for m in row["misses"]:
+            print(f"       miss number {m['nn']}: {m['reply']!r}")
+    worst = min((r["recall"] for r in rows), default=1.0)
+    print(f"niah: {'PASS' if worst >= args.min_recall else 'FAIL'} (worst recall {worst:.3f}, "
+          f"seed {args.seed}, min {args.min_recall})")
+    if args.out:
+        with open(args.out, "w") as f:
+            json.dump({"base": args.base, "model": args.model, "seed": args.seed,
+                       "min_recall": args.min_recall, "rows": rows}, f, indent=1)
+    return 0 if worst >= args.min_recall else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
