+"""Planting, spacing, scoring and the exit codes of tools/niah_gate.py.
+
+    python3 -m unittest tools.test_niah_gate       (no server, no GPU: CI-safe)
+"""
+import io
+import json
+import random
+import re
+import sys
+import tempfile
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import niah_gate
+
+
+def qmap_transport(needles, right=True):
+    """A transport that answers each planted question with its number, or always 42."""
+
+    qmap = {niah_gate.question(nd): str(nd["nn"]) for nd in needles}
+
+    def tp(payload):
+        text = payload["messages"][0]["content"]
+        answer = qmap.get(text.rsplit("\n\n", 1)[-1], "42")
+        return (answer if right else "42"), {"prompt_tokens": int(len(text.split()) * 1.3)}
+
+    return tp
+
+
+class Plant(unittest.TestCase):
+    def test_unique_numbers_and_triples(self):
+        rows = niah_gate.plant(random.Random(7), 24)
+        self.assertEqual(len({r["nn"] for r in rows}), 24)
+        self.assertEqual(len({(r["color"], r["item"], r["place"]) for r in rows}), 24)
+
+    def test_deterministic_under_seed(self):
+        self.assertEqual(niah_gate.plant(random.Random(1), 8), niah_gate.plant(random.Random(1), 8))
+
+    def test_question_carries_no_digits(self):
+        for ndl in niah_gate.plant(random.Random(3), 8):
+            self.assertIsNone(re.search(r"\d", niah_gate.question(ndl)))
+            self.assertIsNotNone(re.search(niah_gate.KEY_RE.format(nn=ndl["nn"]), niah_gate.sentence(ndl)))
+
+
+class Scoring(unittest.TestCase):
+    def test_number_boundaries(self):
+        self.assertIsNotNone(re.search(niah_gate.KEY_RE.format(nn=731), "the number was 731 near the pier"))
+        self.assertIsNone(re.search(niah_gate.KEY_RE.format(nn=731), "1731"))
+        self.assertIsNone(re.search(niah_gate.KEY_RE.format(nn=731), "7310"))
+        self.assertIsNotNone(re.search(niah_gate.KEY_RE.format(nn=731), "731."))
+
+    def test_run_depth_counts_every_needle(self):
+        needles = niah_gate.plant(random.Random(21), 5)
+        got = niah_gate.run_depth(qmap_transport(needles), "", random.Random(21), 1024, 5, 1.35, needles)
+        self.assertEqual((got["needles"], got["hits"], got["recall"]), (5, 5, 1.0))
+
+    def test_run_depth_zero_recall(self):
+        needles = niah_gate.plant(random.Random(22), 5)
+        got = niah_gate.run_depth(qmap_transport(needles, right=False), "", random.Random(22), 1024, 5, 1.35, needles)
+        self.assertEqual((got["hits"], len(got["misses"])), (0, 5))
+
+    def test_spacing_and_size(self):
+        needles = niah_gate.plant(random.Random(5), 4)
+        lines = niah_gate.prompt_words(4000, 1.0, needles)
+        text = " ".join(lines)
+        pos = [text.index(f"number {ndl['nn']}") for ndl in needles]
+        self.assertEqual(pos, sorted(pos))
+        words = text.count(" ") + 1            # the target is in tokens, so the filler's words are what is sized
+        self.assertGreater(words, 3000)        # target 4000 tokens at 1.0 words/token: ~4000 words plus the needles
+        self.assertLess(words, 4400)
+
+
+class Calibrate(unittest.TestCase):
+    def test_usage_gives_the_factor(self):
+        probe_words = (" ".join([niah_gate.FILLER[0]] * 8)).count(" ") + 1
+        tp = lambda payload: ("ok", {"prompt_tokens": probe_words * 13 // 10})
+        self.assertAlmostEqual(niah_gate.calibrate(tp, ""), 1.3)
+
+    def test_no_usage_falls_back(self):
+        with redirect_stderr(io.StringIO()):
+            self.assertEqual(niah_gate.calibrate(lambda payload: ("ok", None), ""), niah_gate.TPW)
+
+
+class Main(unittest.TestCase):
+    def _main(self, transport, extra=()):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            code = niah_gate.main(["http://127.0.0.1:1", "--depths", "512", "--needles", "3",
+                                   "--seed", "9", *extra], transport=transport)
+        return code, out.getvalue()
+
+    def _fixed_plant(self, needles):
+        """Pin plant() so main() and the scripted transport see the same needles."""
+        saved = niah_gate.plant
+        niah_gate.plant = lambda rng, n: list(needles)
+        return saved
+
+    def test_perfect_recall_exits_zero(self):
+        needles = niah_gate.plant(random.Random(9), 3)
+        saved = self._fixed_plant(needles)
+        try:
+            code, out = self._main(qmap_transport(needles))
+        finally:
+            niah_gate.plant = saved
+        self.assertEqual(code, 0)
+        self.assertIn("PASS", out)
+
+    def test_zero_recall_exits_one(self):
+        code, out = self._main(lambda payload: ("42", {"prompt_tokens": 100}))
+        self.assertEqual(code, 1)
+        self.assertIn("FAIL", out)
+
+    def test_transport_error_exits_two(self):
+        def boom(payload):
+            raise RuntimeError("connection refused")
+        code, _ = self._main(boom)
+        self.assertEqual(code, 2)
+
+    def test_out_writes_rows(self):
+        f = None
+        with tempfile.TemporaryDirectory() as d:
+            f = Path(d) / "niah.json"
+            self._main(lambda payload: ("42", {"prompt_tokens": 100}), extra=["--out", str(f)])
+            data = json.loads(f.read_text())
+            self.assertEqual(data["seed"], 9)
+            self.assertEqual(len(data["rows"]), 1)
+            self.assertTrue({"depth", "needles", "hits", "recall", "seconds"} <= set(data["rows"][0]))
+
+
+if __name__ == "__main__":
+    unittest.main()
+
+
+class PostFactoryTest(unittest.TestCase):
+    """A reasoning model answers in reasoning_content while content is null (Qwen 3.8, Hy4)."""
+
+    @staticmethod
+    def _reply(message, usage=None):
+        body = {"choices": [{"message": message}]}
+        if usage:
+            body["usage"] = usage
+
+        class R:
+            def __enter__(self):
+                return self
+
+            def __exit__(self, *a):
+                return False
+
+            def read(self):
+                return json.dumps(body).encode()
+
+        return R()
+
+    def test_null_content_falls_back_to_reasoning(self):
+        from unittest import mock
+        r = self._reply({"content": None, "reasoning_content": "number 12"}, {"prompt_tokens": 7})
+        with mock.patch.object(niah_gate.urllib.request, "urlopen", return_value=r):
+            text, usage = niah_gate.post_factory("http://127.0.0.1:1", 5)({"messages": []})
+        self.assertEqual(text, "number 12")
+        self.assertEqual(usage["prompt_tokens"], 7)
+
+    def test_both_null_is_empty_not_crash(self):
+        from unittest import mock
+        r = self._reply({"content": None, "reasoning_content": None})
+        with mock.patch.object(niah_gate.urllib.request, "urlopen", return_value=r):
+            text, _ = niah_gate.post_factory("http://127.0.0.1:1", 5)({"messages": []})
+        self.assertEqual(text, "")
