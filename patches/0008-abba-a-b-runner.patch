+#!/usr/bin/env python3
+"""Interleaved A/B of two full `basalt-bench` runs in one session: the ABBA of the benchmarking rule.
+
+    ab_bench.py --a 'bin/basalt-bench --model M.basalt ...' --b 'bin/basalt-bench --model M.basalt ...'
+                [--runs 4] [--within 1.5] [--out FILE.json]
+
+Each arm is a command line that runs the real bench; every run is a fresh process and a cold start,
+as basalt-bench defines it. The arms alternate ABBA within each block of four, so one build's drift
+does not land only on the other. Each run's stdout must end with the bench's JSON line; its summary
+gives each test's mean tokens/s and, on the decode fixtures, the mean acceptance. Per test the tool
+prints both arms' medians and min-max, the B/A delta, and FLAT when every test stays within
+--within percent of A. A test regressing beyond the band exits 1 (the worst delta decides); a run
+that fails or prints no parsable JSON exits 2. A run whose power limit reads unknown, or two runs
+that disagree on it, gets a warning: the rule is that every number states its power limit. `--out`
+keeps every per-run figure beside the verdict.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import shlex
+import statistics
+import subprocess
+import sys
+
+BLOCK = ("a", "b", "b", "a")   # ABBA: drift hits both arms mid-block, neither arm only second
+
+
+def run(cmd: str) -> dict:
+    """One basalt-bench run: its JSON, the line after its last '{' that parses."""
+    proc = subprocess.run(shlex.split(cmd), capture_output=True, text=True)
+    if proc.returncode != 0:
+        raise RuntimeError(f"run failed (exit {proc.returncode}): {cmd}\n"
+                           f"tail: {(proc.stdout + proc.stderr).strip().splitlines()[-1:]}")
+    for line in reversed(proc.stdout.splitlines()):
+        line = line.strip()
+        if line.startswith("{"):
+            try:
+                return json.loads(line)
+            except json.JSONDecodeError:
+                continue
+    raise RuntimeError(f"no JSON line at the end of: {cmd}")
+
+
+def plan(runs: int) -> list[str]:
+    """The arm order: whole ABBA blocks, each arm running `runs` times."""
+    if runs <= 0 or runs % 2:
+        raise SystemExit(f"ab: --runs must be a positive even number of runs per arm, got {runs}")
+    return list(BLOCK) * (runs // 2)
+
+
+def summarize(runs_by_arm: dict[str, list[dict]], within: float) -> tuple[list[dict], list[str]]:
+    """Per test the arms' medians and delta, and the warning lines. A run's summary entries give tok_s_mean."""
+    rows, warns = [], []
+    tests = []
+    for doc in runs_by_arm["a"]:
+        for entry in doc.get("summary", []):
+            if entry.get("test") not in [t[0] for t in tests]:
+                tests.append((entry["test"], entry))
+    for name, _ in tests:
+        per = {}
+        for arm in ("a", "b"):
+            vals = [e["tok_s_mean"] for doc in runs_by_arm[arm] for e in doc.get("summary", [])
+                    if e.get("test") == name and isinstance(e.get("tok_s_mean"), (int, float))]
+            if not vals:
+                continue
+            per[arm] = vals
+        if "a" not in per or "b" not in per:
+            warns.append(f"ab: {name}: one arm printed no figure for it; not compared")
+            continue
+        med_a, med_b = statistics.median(per["a"]), statistics.median(per["b"])
+        if med_a <= 0:
+            warns.append(f"ab: {name}: A's median is {med_a}, the delta is meaningless")
+            continue
+        delta = 100.0 * (med_b - med_a) / med_a
+        spread = max((max(v) - min(v)) / statistics.median(v) * 100.0 for v in (per["a"], per["b"]))
+        flag = "FLAT" if abs(delta) <= within else ("BEHIND" if delta < 0 else "AHEAD")
+        if spread > within:
+            flag += f"~noise{spread:.1f}%"
+        rows.append({"test": name, "a": round(med_a, 2), "a_span": [min(per["a"]), max(per["a"])],
+                     "b": round(med_b, 2), "b_span": [min(per["b"]), max(per["b"])],
+                     "delta_pct": round(delta, 2), "verdict": flag,
+                     "accept_a": _mean_acc(runs_by_arm["a"], name),
+                     "accept_b": _mean_acc(runs_by_arm["b"], name)})
+    return rows, warns
+
+
+def _mean_acc(docs: list[dict], name: str) -> float | None:
+    vals = [e["accept_pct_mean"] for doc in docs for e in doc.get("summary", [])
+            if e.get("test") == name and isinstance(e.get("accept_pct_mean"), (int, float))]
+    return round(statistics.mean(vals), 2) if vals else None
+
+
+def power_warnings(runs_by_arm: dict[str, list[dict]]) -> list[str]:
+    labels = {(arm, doc.get("power_limit", "unknown")) for arm, docs in runs_by_arm.items() for doc in docs}
+    uniq = {label for _, label in labels}
+    if len(uniq) > 1:
+        return [f"ab: the runs disagree on the power limit: {sorted(uniq)}; the arms were not at one power"]
+    if uniq and next(iter(uniq)) in ("unknown", "", None):
+        return ["ab: the power limit could not be read; pass --power-label W to basalt-bench on both arms"]
+    return []
+
+
+def main(argv: list[str] | None = None, runner=run) -> int:
+    ap = argparse.ArgumentParser(description="Interleaved A/B of two basalt-bench commands.")
+    ap.add_argument("--a", required=True, help="arm A's basalt-bench command line")
+    ap.add_argument("--b", required=True, help="arm B's basalt-bench command line")
+    ap.add_argument("--runs", type=int, default=4, help="runs per arm (even, ABBA blocks)")
+    ap.add_argument("--within", type=float, default=1.5, help="percent that stays FLAT")
+    ap.add_argument("--out", default="", help="write the full record as JSON here")
+    args = ap.parse_args(argv)
+
+    cmds = {"a": args.a, "b": args.b}
+    order = plan(args.runs)
+    runs_by_arm: dict[str, list[dict]] = {"a": [], "b": []}
+    try:
+        for arm in order:
+            runs_by_arm[arm].append(runner(cmds[arm]))
+    except (RuntimeError, OSError) as exc:
+        print(f"ab: {exc}", file=sys.stderr)
+        return 2
+
+    rows, warns = summarize(runs_by_arm, args.within)
+    warns += power_warnings(runs_by_arm)
+    for line in warns:
+        print(line, file=sys.stderr)
+    if not rows:
+        print("ab: no test printed figures in both arms", file=sys.stderr)
+        return 2
+    print(f"ab: {'test':<12} {'A tok/s':>9} {'B tok/s':>9} {'B/A':>8}  verdict   accept A/B")
+    for r in rows:
+        acc = f"{r['accept_a']}/{r['accept_b']}" if r["accept_a"] is not None else "-"
+        print(f"ab: {r['test']:<12} {r['a']:>9} {r['b']:>9} {r['delta_pct']:>+7.2f}%  {r['verdict']:<12} {acc}")
+    worst = min(r["delta_pct"] for r in rows)
+    verdict = "PASS" if worst >= -args.within else f"FAIL (worst test {worst:+.2f}%)"
+    print(f"ab: {verdict} (band {args.within}%, {args.runs} runs per arm, ABBA order)")
+    if args.out:
+        with open(args.out, "w") as f:
+            json.dump({"a": args.a, "b": args.b, "runs_per_arm": args.runs, "within": args.within,
+                       "rows": rows, "warnings": warns, "raw": runs_by_arm}, f, indent=1)
+    return 0 if worst >= -args.within else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
