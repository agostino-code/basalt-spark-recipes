index 00000000..66ed92c2
--- /dev/null
+++ b/tools/test_ab_bench.py
@@ -0,0 +1,149 @@
+"""The ABBA plan, the summary rows, the power warnings and the exit codes of tools/ab_bench.py.
+
+    python3 -m unittest tools.test_ab_bench        (no engine, no GPU: CI-safe)
+"""
+import io
+import json
+import sys
+import unittest
+from contextlib import redirect_stderr, redirect_stdout
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import ab_bench
+
+
+def doc(tests, power="500W", accept=None):
+    summary = [{"test": t, "tok_s_mean": v} for t, v in tests]
+    if accept:
+        for e in summary:
+            if e["test"] in accept:
+                e["accept_pct_mean"] = accept[e["test"]]
+    return {"power_limit": power, "summary": summary}
+
+
+class Plan(unittest.TestCase):
+    def test_abba_blocks(self):
+        self.assertEqual(ab_bench.plan(2), ["a", "b", "b", "a"])
+        self.assertEqual(ab_bench.plan(4), ["a", "b", "b", "a", "a", "b", "b", "a"])
+
+    def test_odd_runs_rejected(self):
+        with self.assertRaises(SystemExit):
+            ab_bench.plan(3)
+
+
+class Summarize(unittest.TestCase):
+    def test_medians_delta_and_accept(self):
+        a = [doc([("tg conv", 50.0)]), doc([("tg conv", 60.0)])]
+        b = [doc([("tg conv", 55.0)], accept={"tg conv": 70.0}), doc([("tg conv", 56.0)], accept={"tg conv": 80.0})]
+        rows, warns = ab_bench.summarize({"a": a, "b": b}, within=5.0)
+        self.assertEqual(len(rows), 1)
+        r = rows[0]
+        self.assertEqual(r["test"], "tg conv")
+        self.assertAlmostEqual(r["a"], 55.0)      # median of 50/60
+        self.assertAlmostEqual(r["b"], 55.5)
+        self.assertAlmostEqual(r["delta_pct"], 0.91, delta=0.01)
+        self.assertTrue(r["verdict"].startswith("FLAT"))
+        self.assertEqual(r["accept_a"], None)
+        self.assertEqual(r["accept_b"], 75.0)
+
+    def test_band_and_flags(self):
+        a = [doc([("x", 100.0)]), doc([("x", 100.0)])]
+        b = [doc([("x", 110.0)]), doc([("x", 110.0)])]
+        rows, _ = ab_bench.summarize({"a": a, "b": b}, within=1.5)
+        self.assertTrue(rows[0]["verdict"].startswith("AHEAD"))
+        rows, _ = ab_bench.summarize({"a": a, "b": [doc([("x", 90.0)]), doc([("x", 90.0)])]}, within=1.5)
+        self.assertTrue(rows[0]["verdict"].startswith("BEHIND"))
+
+    def test_noise_flag(self):
+        a = [doc([("x", 100.0)]), doc([("x", 100.0)])]
+        b = [doc([("x", 95.0)]), doc([("x", 115.0)])]
+        rows, _ = ab_bench.summarize({"a": a, "b": b}, within=1.5)
+        self.assertIn("~noise", rows[0]["verdict"])
+
+    def test_missing_arm_row_warns(self):
+        a = [doc([("x", 1.0)]), doc([("x", 1.0)])]
+        b = [doc([("y", 1.0)]), doc([("y", 1.0)])]
+        rows, warns = ab_bench.summarize({"a": a, "b": b}, within=1.5)
+        self.assertEqual(rows, [])
+        self.assertTrue(any("no figure" in w for w in warns))
+
+
+class Power(unittest.TestCase):
+    def test_unknown_label_warns(self):
+        docs = {"a": [doc([("x", 1.0)], power="unknown")], "b": [doc([("x", 1.0)], power="unknown")]}
+        self.assertTrue(any("power" in w for w in ab_bench.power_warnings(docs)))
+
+    def test_disagreement_warns(self):
+        docs = {"a": [doc([("x", 1.0)], power="400W")], "b": [doc([("x", 1.0)], power="500W")]}
+        self.assertTrue(any("disagree" in w for w in ab_bench.power_warnings(docs)))
+
+    def test_matched_label_is_silent(self):
+        docs = {"a": [doc([("x", 1.0)], power="500W")], "b": [doc([("x", 1.0)], power="500W")]}
+        self.assertEqual(ab_bench.power_warnings(docs), [])
+
+
+class Main(unittest.TestCase):
+    def _main(self, runner, runs=2):
+        out, err = io.StringIO(), io.StringIO()
+        with redirect_stdout(out), redirect_stderr(err):
+            code = ab_bench.main(["--a", "A", "--b", "B", "--runs", str(runs), "--within", "1.5"], runner=runner)
+        return code, out.getvalue(), err.getvalue()
+
+    def test_flat_passes_and_alternates(self):
+        seen = []
+
+        def runner(cmd):
+            seen.append(cmd)
+            base = 100.0 if cmd == "A" else 100.5
+            return doc([("tg conv", base)])
+
+        code, out, _ = self._main(runner)
+        self.assertEqual(code, 0)
+        self.assertIn("PASS", out)
+        self.assertEqual(seen, ["A", "B", "B", "A"])
+
+    def test_regression_fails(self):
+        def runner(cmd):
+            return doc([("tg conv", 100.0 if cmd == "A" else 90.0)])
+
+        code, out, _ = self._main(runner)
+        self.assertEqual(code, 1)
+        self.assertIn("FAIL", out)
+
+    def test_broken_run_exits_two(self):
+        def runner(cmd):
+            raise RuntimeError("boom")
+
+        code, _, err = self._main(runner)
+        self.assertEqual(code, 2)
+        self.assertIn("boom", err)
+
+    def test_no_common_tests_exits_two(self):
+        def runner(cmd):
+            return doc([("only_a" if cmd == "A" else "only_b", 5.0)])
+
+        code, _, err = self._main(runner)
+        self.assertEqual(code, 2)
+
+
+class Run(unittest.TestCase):
+    def test_run_parses_trailing_json(self):
+        import shlex
+        script = "print('basalt-bench: noise'); print('" + json.dumps({"power_limit": "500W", "summary": []}) + "')"
+        got = ab_bench.run(shlex.join([sys.executable, "-c", script]))
+        self.assertEqual(got["power_limit"], "500W")
+
+    def test_run_raises_on_nonzero_exit(self):
+        import shlex
+        with self.assertRaises(RuntimeError):
+            ab_bench.run(shlex.join([sys.executable, "-c", "raise SystemExit(3)"]))
+
+    def test_run_raises_without_json(self):
+        import shlex
+        with self.assertRaises(RuntimeError):
+            ab_bench.run(shlex.join([sys.executable, "-c", "print('no json here')"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
